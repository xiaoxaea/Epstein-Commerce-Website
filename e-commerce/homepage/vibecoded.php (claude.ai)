<?php
declare(strict_types=1);
session_start();

// --- Database (SQLite file, created automatically) ---
$pdo = new PDO('sqlite:' . __DIR__ . '/users.db');
$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
$pdo->exec('CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
)');

// --- Helpers ---
function e(string $value): string
{
    return htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
}

if (empty($_SESSION['csrf'])) {
    $_SESSION['csrf'] = bin2hex(random_bytes(32));
}

$mode   = ($_GET['mode'] ?? 'login') === 'register' ? 'register' : 'login';
$errors = [];
$old    = ['username' => '', 'email' => ''];

// --- Handle form submissions ---
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!hash_equals($_SESSION['csrf'], $_POST['csrf'] ?? '')) {
        http_response_code(403);
        exit('Invalid request token.');
    }

    $action = $_POST['action'] ?? '';

    if ($action === 'register') {
        $mode     = 'register';
        $username = trim($_POST['username'] ?? '');
        $email    = trim($_POST['email'] ?? '');
        $password = $_POST['password'] ?? '';
        $confirm  = $_POST['confirm'] ?? '';
        $old      = ['username' => $username, 'email' => $email];

        if (!preg_match('/^[A-Za-z0-9_]{3,20}$/', $username)) {
            $errors[] = 'Username must be 3 to 20 letters, numbers or underscores.';
        }
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $errors[] = 'Enter a valid email address.';
        }
        if (strlen($password) < 8) {
            $errors[] = 'Password must be at least 8 characters.';
        }
        if ($password !== $confirm) {
            $errors[] = 'Passwords do not match.';
        }

        if (!$errors) {
            $stmt = $pdo->prepare('SELECT 1 FROM users WHERE username = :u OR email = :e');
            $stmt->execute([':u' => $username, ':e' => $email]);
            if ($stmt->fetch()) {
                $errors[] = 'That username or email is already registered.';
            }
        }

        if (!$errors) {
            $stmt = $pdo->prepare(
                'INSERT INTO users (username, email, password_hash) VALUES (:u, :e, :p)'
            );
            $stmt->execute([
                ':u' => $username,
                ':e' => $email,
                ':p' => password_hash($password, PASSWORD_DEFAULT),
            ]);
            session_regenerate_id(true);
            $_SESSION['user_id']  = (int) $pdo->lastInsertId();
            $_SESSION['username'] = $username;
            header('Location: auth.php');
            exit;
        }
    } elseif ($action === 'login') {
        $mode     = 'login';
        $login    = trim($_POST['login'] ?? '');
        $password = $_POST['password'] ?? '';
        $old['username'] = $login;

        $stmt = $pdo->prepare('SELECT * FROM users WHERE username = :l OR email = :l');
        $stmt->execute([':l' => $login]);
        $user = $stmt->fetch(PDO::FETCH_ASSOC);

        if ($user && password_verify($password, $user['password_hash'])) {
            session_regenerate_id(true);
            $_SESSION['user_id']  = (int) $user['id'];
            $_SESSION['username'] = $user['username'];
            header('Location: auth.php');
            exit;
        }
        $errors[] = 'Username or password is incorrect.';
    } elseif ($action === 'logout') {
        $_SESSION = [];
        session_destroy();
        header('Location: auth.php');
        exit;
    }
}

$loggedIn = isset($_SESSION['user_id']);
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $loggedIn ? 'Welcome' : ($mode === 'register' ? 'Create account' : 'Log in') ?></title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<main class="card">
<?php if ($loggedIn): ?>
    <h1>Welcome, <?= e($_SESSION['username']) ?></h1>
    <p class="sub">You are logged in.</p>
    <form method="post">
        <input type="hidden" name="csrf" value="<?= e($_SESSION['csrf']) ?>">
        <input type="hidden" name="action" value="logout">
        <button class="btn" type="submit">Log out</button>
    </form>
<?php else: ?>
    <h1><?= $mode === 'register' ? 'Create your account' : 'Log in' ?></h1>
    <p class="sub"><?= $mode === 'register' ? 'It takes less than a minute.' : 'Enter your details to continue.' ?></p>

    <nav class="tabs">
        <a href="?mode=login" class="<?= $mode === 'login' ? 'on' : '' ?>">Log in</a>
        <a href="?mode=register" class="<?= $mode === 'register' ? 'on' : '' ?>">Create account</a>
    </nav>

    <?php if ($errors): ?>
        <ul class="errors" role="alert">
            <?php foreach ($errors as $error): ?>
                <li><?= e($error) ?></li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

    <?php if ($mode === 'register'): ?>
    <form method="post" novalidate>
        <input type="hidden" name="csrf" value="<?= e($_SESSION['csrf']) ?>">
        <input type="hidden" name="action" value="register">
        <label>Username
            <input type="text" name="username" value="<?= e($old['username']) ?>" autocomplete="username" required>
        </label>
        <label>Email
            <input type="email" name="email" value="<?= e($old['email']) ?>" autocomplete="email" required>
        </label>
        <label>Password
            <input type="password" name="password" autocomplete="new-password" required>
            <span class="hint">At least 8 characters.</span>
        </label>
        <label>Confirm password
            <input type="password" name="confirm" autocomplete="new-password" required>
        </label>
        <button class="btn" type="submit">Create account</button>
    </form>
    <?php else: ?>
    <form method="post" novalidate>
        <input type="hidden" name="csrf" value="<?= e($_SESSION['csrf']) ?>">
        <input type="hidden" name="action" value="login">
        <label>Username or email
            <input type="text" name="login" value="<?= e($old['username']) ?>" autocomplete="username" required>
        </label>
        <label>Password
            <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button class="btn" type="submit">Log in</button>
    </form>
    <?php endif; ?>
<?php endif; ?>
</main>
</body>
</html>
